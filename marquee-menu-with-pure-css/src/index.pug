.wrapper 
  each el, i in ITEMS
    label.item= el.name
      input(type='radio', name='city', value=el.name, checked=i===0)
    
  .marquee-list
    each el in ITEMS
      .marquee-row
        .marquee-inner
          each _ in Array.from({ length: 4 })
            span= el.name
            img(src=el.src, alt=el.name)